     ] ) ;
     fhir:security ( [
       fhir:system [
         fhir:v "http://terminology.cibmtr.org/codesystem/transplant-center"^^xsd:anyURI ;
         fhir:l <http://terminology.cibmtr.org/codesystem/transplant-center>
       ] ;
       fhir:code [ fhir:v "rc_99999" ] ;
       fhir:display [ fhir:v "99999 My Transplant Center" ]
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient PatientExample6</b></p><a name=\"PatientExample6\"> </a><a name=\"hcPatientExample6\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-cibmtr-patient.html\">CIBMTR Patient Profile (us-core)</a></p><p style=\"margin-bottom: 0px\">Security Label: </p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\"> Female, DoB Unknown ( http://terminology.cibmtr.org/identifier/CRID#123456)</p><hr/></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "http://terminology.cibmtr.org/identifier/CRID"^^xsd:anyURI ;
       fhir:l <http://terminology.cibmtr.org/identifier/CRID>
     ] ;
     fhir:value [ fhir:v "123456" ]
  ] ) ; # 
  fhir:name ( [
     fhir:extension ( [
       fhir:url [
         fhir:v "http://hl7.org/fhir/StructureDefinition/data-absent-reason"^^xsd:anyURI ;
